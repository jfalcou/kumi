## Only what belongs to this project. What the fleet shares comes from the @INCLUDE at the bottom, what can be worked
## out from the project's name is worked out there too, and anything named nowhere is a doxygen default we have no
## reason to restate.
##======================================================================================================================

PROJECT_BRIEF          = "Flawless Fluorite"
PROJECT_LOGO           = logo.svg
LAYOUT_FILE            = layout.xml

## What to read, and where the @include of a snippet looks for its file
INPUT                  = ../include .
INCLUDE_PATH           = ../include
EXAMPLE_PATH           = ../test . ../include/kumi
FILE_PATTERNS          = *.hpp *.md

## The implementation namespace is not part of the interface
EXCLUDE_SYMBOLS        = _::* kumi::_::*

TOC_INCLUDE_HEADINGS   = 5
GENERATE_LATEX         = NO

##======================================================================================================================
## What the fleet shares, last so that it wins over anything above
##======================================================================================================================
@INCLUDE               = $(DOXYGEN_ASSETS)/base.doxyfile

## What this project adds on top of it. color.css is written into the output by copa_setup_doxygen, from the same
## numbers that tint doxygen's own widgets.
HTML_EXTRA_STYLESHEET += $(DOXYGEN_ASSETS)/custom.css
HTML_EXTRA_STYLESHEET += $(DOXYGEN_OUPUT)/color.css

## KUMI keeps its own header, for the social card metadata the shared one does not carry yet. See copacabana#75.
HTML_HEADER            = base.html
HTML_EXTRA_FILES      += card.png

## The macro that gives every entity its inline ABI tag, expanded away so it does not show up in every signature.
PREDEFINED            += "KUMI_ABI=inline"

## The markup doxygen-awesome-tabs.js animates. The fragment ships that script but not these, see copacabana#78.
ALIASES               += tab_begin="<div class=\"tabbed\">"
ALIASES               += tab_end="</div>"
ALIASES               += tab{1}="- <b class=\"tab-title\">\1</b>"
